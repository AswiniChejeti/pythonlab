   "source": [
    "#to change global value\n",
    "g=8\n",
    "def fun():\n",
    "    global g\n",
    "    g=10\n",
    "def start():\n",
    "    print(\"before fun :\",g)\n",
    "    fun()\n",
    "    print(\"after fun :\",g)\n",
    "start()"
   ]
